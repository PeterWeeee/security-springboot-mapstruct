DB_URL=jdbc:sqlserver://localhost:1433;databaseName=webst_security_v3;encrypt=false;trustServerCertificate=true;sslProtocol=TLSv1.2;characterEncoding=UTF-8
DB_USERNAME=sa
DB_PASSWORD=123456

